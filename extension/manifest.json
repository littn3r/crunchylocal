{
  "manifest_version": 3,
  "name": "Crunchy Local — sign-in",
  "version": "1.1.0",
  "description": "Connect your Crunchyroll session to your own Crunchy Local player after official sign-in.",
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://*.crunchyroll.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
